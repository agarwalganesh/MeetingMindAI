# Security Configuration
# REQUIRED: Replace with a strong random key (e.g. openssl rand -hex 32)
SECRET_KEY=CHANGE_ME_USE_A_STRONG_RANDOM_KEY_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS: Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Asynchronous processing: how many transcription/analysis jobs may run at once
# in the in-process background worker pool. Keep low — transcription is heavy and
# shares a single in-process Whisper model. (POST /process returns a task_id;
# poll GET /jobs/{id} or subscribe to GET /jobs/{id}/stream for live status.)
MAX_CONCURRENT_JOBS=2

# Database Settings
# For SQLite (default development):
DATABASE_URL=sqlite:///../database/meetingmind.db
# For PostgreSQL (production ready):
# DATABASE_URL=postgresql://user:password@localhost:5432/meetingmind

# AI / ML Model APIs
# Set to enable Live Mode, otherwise local mock offline fallbacks will run automatically
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
LANGCHAIN_API_KEY=your_langchain_api_key_here
LANGCHAIN_MODEL=openai:gpt-4o-mini
LANGGRAPH_API_KEY=your_langgraph_api_key_here
LANGGRAPH_MODEL=openai:gpt-4o-mini

# Speaker Diarization (label transcript turns as "Speaker 1:", "Speaker 2:")
# ENABLE_DIARIZATION=true turns it on. Acoustic diarization needs pyannote.audio
# installed (see backend/requirements.txt) AND a HuggingFace token with access to
# the gated model pyannote/speaker-diarization-3.1. Without them it falls back to
# a text-based heuristic (preserves existing "Name:" cues).
ENABLE_DIARIZATION=false
HUGGINGFACE_TOKEN=your_huggingface_token_here
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1

# Frontend Configurations
VITE_API_URL=http://localhost:8000/api
